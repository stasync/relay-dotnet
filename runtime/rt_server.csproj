<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>UdpRelay</RootNamespace>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <!-- Keel libraries (https://github.com/stasync/keel-dotnet) are downloaded from GitHub releases on first build and cached in plugins/keel/. -->
    <PropertyGroup>
        <KeelVersion>latest-build</KeelVersion>
        <KeelTargetFramework>net10.0</KeelTargetFramework>
        <KeelAsset>keel-$(KeelVersion)-$(KeelTargetFramework).zip</KeelAsset>
        <KeelUrl>https://github.com/stasync/keel-dotnet/releases/download/$(KeelVersion)/$(KeelAsset)</KeelUrl>
        <KeelDir>$(MSBuildThisFileDirectory)..\plugins\keel\$(KeelVersion)\$(KeelTargetFramework)\</KeelDir>
    </PropertyGroup>

    <Target Name="DownloadKeel" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(KeelDir)Keel.Utils.dll')">
        <DownloadFile SourceUrl="$(KeelUrl)" DestinationFolder="$(KeelDir)" />
        <Unzip SourceFiles="$(KeelDir)$(KeelAsset)" DestinationFolder="$(KeelDir)" />
    </Target>

    <ItemGroup>
        <Reference Include="Keel.Utils">
            <HintPath>$(KeelDir)Keel.Utils.dll</HintPath>
        </Reference>
        <Reference Include="Keel.Networking">
            <HintPath>$(KeelDir)Keel.Networking.dll</HintPath>
        </Reference>
        <Reference Include="Keel.DependencyInjection">
            <HintPath>$(KeelDir)Keel.DependencyInjection.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
